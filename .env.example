# Sao chép thành .env (KHÔNG commit file .env)
PORT=3000

# Nhà cung cấp AI: anthropic (mặc định) hoặc openai (OpenAI hoặc dịch vụ tương thích, đặt thêm AI_BASE_URL)
AI_PROVIDER=anthropic
AI_API_KEY=your_ai_api_key_here
# AI_BASE_URL=
# AI_MODEL_TEXT=
# AI_MODEL_VISION=

# Bảo vệ chi phí AI
RATE_LIMIT_PER_MIN=20
DAILY_REQUEST_LIMIT=500
# ALLOWED_ORIGINS=https://ten-mien-frontend.com
# TRUST_PROXY_HOPS=1
